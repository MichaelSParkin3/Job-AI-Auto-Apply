# ------------------------------------------------------------
# Git Ignore for Job-AI-Auto-Apply (Python + Node monorepo)
# ------------------------------------------------------------

# Node / pnpm
node_modules/
**/node_modules/
.pnpm-store/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
pnpm-lock.yaml
**/dist/
**/.vite/
**/.turbo/
**/coverage/
**/storybook-static/
**/*.tsbuildinfo
**/.eslintcache

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.eggs/
*.egg-info/
build/
dist/
.build/
.tox/
.pytest_cache/
htmlcov/
.mypy_cache/
.ruff_cache/
.pyre/
.coverage
coverage.xml

# Virtual environments
.venv/
venv/
env/
ENV/

# OS / IDE
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# Env & secrets
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.example

# Project artifacts (keep .gitkeep placeholders)
config/config.yaml
history/*
!history/.gitkeep
runs/*
!runs/.gitkeep
.local/*
!.local/.gitkeep
data/profiles/*
!data/profiles/.gitkeep
data/resumes/*

# Playwright / test outputs
playwright-report/
test-results/
playwright/.cache/
.playwright/

# Logs
*.log
logs/

# Binary artifacts
*.png

# Local AI debug and scratch
.ai/*
!.ai/.gitkeep

# Custom scripts
setup.sh